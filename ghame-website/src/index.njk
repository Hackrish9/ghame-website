---
layout: layouts/base.njk
bodyClass: home
title: Home
---
{% import "partials/icons.njk" as ic %}
{%- set h = home %}
{%- set greet = "Hello " ~ site.brand ~ ", " %}

<section class="hero" aria-labelledby="hero-title">
  {%- if h.hero.video %}
  <video class="hero-media" autoplay muted loop playsinline preload="metadata"{% if h.hero.image %} poster="{{ h.hero.image }}"{% endif %} aria-hidden="true">
    <source src="{{ h.hero.video }}" type="video/mp4">
  </video>
  {%- elif h.hero.image %}
  <img class="hero-media" src="{{ h.hero.image }}" alt="{{ h.hero.image_alt }}" fetchpriority="high">
  {%- else %}
  <img class="hero-vine" src="/assets/img/illustrations/vine.svg" alt="" width="840" height="780">
  {%- endif %}
  <div class="wrap hero-inner">
    {%- if h.hero.kicker %}<p class="hero-kicker">{{ h.hero.kicker }}</p>{% endif %}
    <h1 id="hero-title"><span class="hero-line-1">{{ h.hero.headline }}</span> <span class="hero-line-2">{{ h.hero.headline_2 }}</span></h1>
    <p class="hero-intro">{{ h.hero.intro }}</p>
    <div class="btn-row">
      {%- for b in h.hero.buttons %}
      <a class="btn btn-hero-{{ b.style or 'primary' }}" href="{{ b.url }}">{{ b.label }}</a>
      {%- endfor %}
    </div>
  </div>
</section>

{%- if h.trust.show and h.trust.items.length %}
<section class="trust" aria-label="Why Ghame">
  <ul class="wrap trust-list">
    {%- for t in h.trust.items %}
    <li>{{ ic.icon(t.icon or "check", 24) }}<span>{{ t.label }}</span></li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}

{%- if h.essence.show %}
<section class="section" id="essence" aria-labelledby="essence-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="essence-h">{{ h.essence.heading }}</h2>
      <p>{{ h.essence.intro }}</p>
    </div>
    <div class="plate-grid">
      {%- for s in h.essence.spices %}
      {%- set linked = collections.shopProducts | findProduct(s.product) %}
      <article class="plate">
        <div class="plate-top">
          <span class="latin">{{ s.latin }}</span>
          {%- if s.in_range %}<span class="plate-badge">In the Ghame range</span>{% endif %}
        </div>
        {%- if s.image %}<img class="plate-img" src="{{ s.image }}" alt="{{ s.image_alt }}" loading="lazy" width="200" height="170">{% endif %}
        <h3>{{ s.name }}</h3>
        {%- if s.name_si %}<p class="si" lang="si">{{ s.name_si }}</p>{% endif %}
        <p class="plate-tagline">{{ s.tagline }}</p>
        <p class="plate-part">{{ s.part_used }}</p>
        {%- if linked %}
        <a class="plate-link" href="{{ linked.url }}">Shop {{ linked.data.title }}</a>
        {%- else %}
        <a class="plate-link" href="{{ site.contact.whatsapp | waLink(greet ~ 'I would like to know about ' ~ s.name ~ '.') }}" target="_blank" rel="noopener">Ask about availability</a>
        {%- endif %}
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if h.nutmeg_mace.show %}
<section class="section fruit" aria-labelledby="fruit-h">
  <div class="wrap fruit-grid">
    <div class="fruit-text">
      <p class="latin">{{ h.nutmeg_mace.latin }}</p>
      <h2 id="fruit-h">{{ h.nutmeg_mace.heading }}</h2>
      <p class="lead">{{ h.nutmeg_mace.body }}</p>
      <ol class="stage-list">
        {%- for st in h.nutmeg_mace.stages %}
        <li>
          {%- if st.image %}<img src="{{ st.image }}" alt="" loading="lazy" width="160" height="80">{% endif %}
          <p><strong>{{ st.title }}</strong> {{ st.text }}</p>
        </li>
        {%- endfor %}
      </ol>
    </div>
    <figure class="fruit-figure">
      {%- if h.nutmeg_mace.video %}
      <video autoplay muted loop playsinline preload="metadata"{% if h.nutmeg_mace.image %} poster="{{ h.nutmeg_mace.image }}"{% endif %} aria-label="{{ h.nutmeg_mace.image_alt }}"><source src="{{ h.nutmeg_mace.video }}" type="video/mp4"></video>
      {%- elif h.nutmeg_mace.image %}
      <img src="{{ h.nutmeg_mace.image }}" alt="{{ h.nutmeg_mace.image_alt }}" loading="lazy" width="560" height="520">
      {%- endif %}
    </figure>
  </div>
</section>
{%- endif %}

{%- if h.senses.show %}
<section class="section senses" aria-labelledby="senses-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="senses-h">{{ h.senses.heading }}</h2>
      <p>{{ h.senses.intro }}</p>
    </div>
    <div class="senses-grid">
      {%- for s in h.senses.items %}
      <article class="sense{% if not s.image %} no-photo{% endif %}">
        {%- if s.image %}<img src="{{ s.image }}" alt="{{ s.image_alt }}" loading="lazy">{% endif %}
        <div class="sense-body">
          <h3>{{ s.title }}</h3>
          <p class="sense-sub">{{ s.subtitle }}</p>
          <p>{{ s.text }}</p>
        </div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if h.journey.show %}
<section class="section journey" aria-labelledby="journey-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="journey-h">{{ h.journey.heading }}</h2>
      <p>{{ h.journey.intro }}</p>
    </div>
    <ol class="steps steps-7">
      {%- for st in h.journey.steps %}
      <li><span class="step-n">{{ loop.index }}</span><h3>{{ st.title }}</h3><p>{{ st.text }}</p></li>
      {%- endfor %}
    </ol>
    {%- if h.journey.note %}<p class="journey-note">{{ h.journey.note }}</p>{% endif %}
    {%- if h.journey.video %}
    <video class="journey-media" autoplay muted loop playsinline preload="metadata"{% if h.journey.image %} poster="{{ h.journey.image }}"{% endif %} aria-label="{{ h.journey.image_alt }}"><source src="{{ h.journey.video }}" type="video/mp4"></video>
    {%- elif h.journey.image %}
    <img class="journey-media" src="{{ h.journey.image }}" alt="{{ h.journey.image_alt }}" loading="lazy">
    {%- endif %}
  </div>
</section>
{%- endif %}

{%- if h.shop.show and collections.shopProducts.length %}
{%- set featured = collections.shopProducts | featured(h.shop.count) %}
{%- if not featured.length %}{% set featured = collections.shopProducts | limit(h.shop.count) %}{% endif %}
<section class="section shop-teaser" id="shop" aria-labelledby="shop-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="shop-h">{{ h.shop.heading }}</h2>
      <p>{{ h.shop.intro }}</p>
    </div>
    <nav class="cat-links" aria-label="Shop by category">
      {%- for c in categories.items %}{% if collections.shopProducts | inCategory(c.id) | length %}
      <a class="chip-link" href="/shop/?category={{ c.id }}">{{ c.name }}</a>
      {%- endif %}{% endfor %}
    </nav>
    <div class="product-grid">
      {%- for p in featured %}{% include "partials/product-card.njk" %}{% endfor %}
    </div>
    <p class="center"><a class="btn btn-outline" href="/shop/">{{ h.shop.button }}</a></p>
  </div>
</section>
{%- endif %}

{%- if h.professional.show or h.export.show %}
<section class="bands" aria-label="Business customers">
  {%- if h.professional.show %}
  <div class="band band-pro">
    {%- if h.professional.image %}<img class="band-img" src="{{ h.professional.image }}" alt="{{ h.professional.image_alt }}" loading="lazy">{% endif %}
    <div class="band-body">
      <p class="band-label">Ghame Professional</p>
      <h2>{{ h.professional.heading }}</h2>
      <p>{{ h.professional.text }}</p>
      {%- if h.professional.note %}<p class="band-note">{{ h.professional.note }}</p>{% endif %}
      <div class="btn-row">
        <a class="btn btn-light" href="/professional/#quote">Request a quotation</a>
        <a class="btn btn-ghost-light" href="{{ site.contact.whatsapp | waLink(greet ~ 'I would like a sample for my kitchen.') }}" target="_blank" rel="noopener">Request a sample</a>
      </div>
    </div>
  </div>
  {%- endif %}
  {%- if h.export.show %}
  <div class="band band-export" id="export">
    {%- if h.export.image %}<img class="band-img" src="{{ h.export.image }}" alt="{{ h.export.image_alt }}" loading="lazy">{% endif %}
    <div class="band-body">
      <p class="band-label">Export</p>
      <h2>{{ h.export.heading }}</h2>
      <p>{{ h.export.text }}</p>
      <div class="btn-row">
        <a class="btn btn-dark" href="/professional/#export">Send an export enquiry</a>
      </div>
    </div>
  </div>
  {%- endif %}
</section>
{%- endif %}

{%- if h.quality.show %}
<section class="section quality" id="quality" aria-labelledby="quality-h">
  <div class="wrap quality-grid">
    <div>
      <h2 id="quality-h">{{ h.quality.heading }}</h2>
      <p class="lead">{{ h.quality.text }}</p>
      <a class="btn btn-wa" href="{{ site.contact.whatsapp | waLink(greet ~ 'the batch code on my pack is: ') }}" target="_blank" rel="noopener">{{ ic.icon("whatsapp", 20) }} Ask about your batch code</a>
      {%- set certs = site.certifications | liveCerts %}
      {%- if certs.length %}
      <ul class="cert-list">
        {%- for c in certs %}<li>{{ ic.icon("shield", 20) }}<a href="{{ c.certificate or '/our-story/#certifications' }}" target="_blank" rel="noopener">{{ c.name }}</a></li>{% endfor %}
      </ul>
      {%- endif %}
    </div>
    <ol class="trace-list">
      {%- for st in h.quality.steps %}
      <li><span class="step-n">{{ loop.index }}</span><div><h3>{{ st.title }}</h3><p>{{ st.text }}</p></div></li>
      {%- endfor %}
    </ol>
  </div>
</section>
{%- endif %}

{%- if h.recipes.show and collections.recipes.length %}
<section class="section recipes-teaser" aria-labelledby="recipes-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="recipes-h">{{ h.recipes.heading }}</h2>
      <a class="text-link" href="/recipes/">All recipes</a>
    </div>
    <div class="recipe-grid">
      {%- for r in collections.recipes | limit(h.recipes.count) %}{% include "partials/recipe-card.njk" %}{% endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if h.story.show %}
<section class="section story" aria-labelledby="story-h">
  <div class="wrap story-grid">
    <div>
      <h2 id="story-h">{{ h.story.heading }}</h2>
      <p class="lead">{{ h.story.text }}</p>
      <ul class="tick-list">
        {%- for pt in h.story.points %}<li>{{ ic.icon("check", 22) }}<span>{{ pt.text }}</span></li>{% endfor %}
      </ul>
      <a class="text-link" href="/our-story/">Read our story</a>
    </div>
    {%- if h.story.image %}
    <img class="story-img" src="{{ h.story.image }}" alt="{{ h.story.image_alt }}" loading="lazy">
    {%- else %}
    <img class="story-img is-illustration" src="/assets/img/illustrations/cinnamon.svg" alt="" loading="lazy" width="200" height="170">
    {%- endif %}
  </div>
</section>
{%- endif %}
