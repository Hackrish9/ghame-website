{#- Stroke icons. Usage: {% import "partials/icons.njk" as ic %} {{ ic.icon("leaf") }} -#}
{% macro icon(name, size=22) -%}
<svg class="icon icon-{{ name }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- if name == "leaf" -%}<path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/><path d="M5 19c3-4 6-7 10-9"/>
{%- elif name == "check" -%}<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.7 2.7L16 9.8"/>
{%- elif name == "chef" -%}<path d="M7 18h10v3H7z"/><path d="M7 18v-5a4 4 0 0 1-1-7.6A4 4 0 0 1 12 3a4 4 0 0 1 6 2.4A4 4 0 0 1 17 13v5"/>
{%- elif name == "box" -%}<path d="M3.5 7.5L12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5L12 12l8.5-4.5"/><path d="M12 12v9"/>
{%- elif name == "globe" -%}<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/>
{%- elif name == "trace" -%}<path d="M4 5v14M7 5v14M10 5v14M14 5v14M17 5v14M20 5v14"/>
{%- elif name == "truck" -%}<path d="M3 6h11v10H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>
{%- elif name == "shield" -%}<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-4.5"/>
{%- elif name == "search" -%}<circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>
{%- elif name == "cart" -%}<path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
{%- elif name == "menu" -%}<path d="M4 7h16M4 12h16M4 17h16"/>
{%- elif name == "close" -%}<path d="M6 6l12 12M18 6L6 18"/>
{%- elif name == "phone" -%}<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>
{%- elif name == "mail" -%}<path d="M3 6h18v12H3z"/><path d="M3 7l9 6 9-6"/>
{%- elif name == "clock" -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{%- elif name == "pin" -%}<path d="M12 21s-7-6.3-7-12a7 7 0 0 1 14 0c0 5.7-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/>
{%- elif name == "plus" -%}<path d="M12 5v14M5 12h14"/>
{%- elif name == "minus" -%}<path d="M5 12h14"/>
{%- elif name == "trash" -%}<path d="M4 7h16"/><path d="M9 7V4h6v3"/><path d="M6 7l1 13h10l1-13"/>
{%- elif name == "download" -%}<path d="M12 4v11"/><path d="M7 10l5 5 5-5"/><path d="M5 20h14"/>
{%- elif name == "whatsapp" -%}<path d="M4 20l1.3-4.2A8.5 8.5 0 1 1 8.4 19z"/><path d="M9.2 8.6c.3-.6.8-.6 1.1-.1l.8 1.6c.1.3 0 .6-.2.8l-.5.5c.5 1 1.3 1.8 2.3 2.3l.5-.5c.2-.2.5-.3.8-.2l1.6.8c.5.3.5.8-.1 1.1-.9.6-2 .7-3.1.2a8 8 0 0 1-3.5-3.5c-.5-1.1-.4-2.2.3-3z"/>
{%- else -%}<circle cx="12" cy="12" r="3"/>
{%- endif -%}
</svg>
{%- endmacro %}
