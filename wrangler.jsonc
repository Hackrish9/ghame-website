{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghame-website",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-21",
  "keep_vars": true,
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
